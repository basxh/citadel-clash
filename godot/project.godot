[application]

config/name="Citadel Clash"
config/description="3D Base-Defense Strategy Game"
config/version="0.1.0"
config/tags=PackedStringArray("strategy", "3d", "defense", "multiplayer")
run/main_scene="res://scenes/main_game.tscn"
config/features=PackedStringArray("4.4", "Forward+")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 1)
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"

